{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexqzm/cps-supply-chain-atlas/schema/sources.schema.json",
  "title": "Источники атласа",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sources"],
  "properties": {
    "schema": {"const": "cps-atlas/sources/v1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "date", "url", "kind", "language", "checked"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 3},
          "authors": {"type": "array", "items": {"type": "string", "minLength": 2}},
          "publisher": {"type": "string", "minLength": 2},
          "date": {"oneOf": [{"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"}, {"type": "null"}],
                   "description": "Дата публикации; null — на странице не указана."},
          "updated": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
          "url": {"type": "string", "pattern": "^https://"},
          "kind": {"enum": ["government-advisory", "vendor-advisory", "vendor-report", "vendor-statement",
                            "postmortem", "research-paper", "conference-talk", "thesis", "framework",
                            "recall-notice", "mailing-list", "dataset", "news"]},
          "language": {"enum": ["en", "ru", "de"]},
          "checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                      "description": "Когда автор сверил с источником факты, которые на него ссылаются."},
          "note": {"type": "string"}
        }
      }
    }
  }
}
